---
import Icon from './Icon.astro';
import site from '../content/site.json';
import services from '../content/services.json';
import { u, stripBase } from '../lib/url';
const { company } = site;
const path = stripBase(Astro.url.pathname);
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="hdr" id="hdr">
  <div class="wrap hdr-in">
    <a href={u('/')} class="logo" aria-label="ПП «333», на головну">
      <span class="logo-mark"><Icon name="sparkles" size={15} /></span>
      <span class="logo-name">333</span>
      <span class="logo-tag">{company.tagline}</span>
    </a>

    <nav class="nav" aria-label="Основне меню">
      <div class="nav-drop">
        <a href={u('/#poslugy')} class:list={['nav-link', { active: path.startsWith('/poslugy') }]}>Послуги <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M6 9l6 6 6-6"/></svg></a>
        <div class="drop">
          {services.map((s) => (
            <a href={u(`/poslugy/${s.slug}/`)} class="drop-item">
              <span class="drop-ico"><Icon name={s.icon} size={18} /></span>
              <span><b>{s.title}</b><small>{s.priceFrom}</small></span>
            </a>
          ))}
        </div>
      </div>
      <a href={u('/tsiny/')} class:list={['nav-link', { active: isActive('/tsiny') }]}>Ціни</a>
      <a href={u('/#kliienty')} class="nav-link">Клієнти</a>
      <a href={u('/#yak-pratsiuiemo')} class="nav-link">Як працюємо</a>
      <a href={u('/kontakty/')} class:list={['nav-link', { active: isActive('/kontakty') }]}>Контакти</a>
    </nav>

    <div class="hdr-cta">
      <a href={`tel:${company.phoneHref}`} class="hdr-phone"><Icon name="phone" size={16} /> {company.phone}</a>
      <button type="button" class="btn btn-outline hdr-btn" data-open-callback>Передзвоніть мені</button>
      <a href={`tel:${company.phoneHref}`} class="hdr-call-m" aria-label="Зателефонувати"><Icon name="phone" size={19} /></a>
      <button type="button" class="burger" aria-label="Відкрити меню" aria-expanded="false" aria-controls="mnav" id="burger"><Icon name="menu" size={22} /></button>
    </div>
  </div>

  <div class="mnav" id="mnav" hidden>
    <div class="wrap">
      <p class="mnav-label">Послуги</p>
      {services.map((s) => (
        <a href={u(`/poslugy/${s.slug}/`)} class="mnav-svc"><span class="drop-ico"><Icon name={s.icon} size={18} /></span>{s.title}</a>
      ))}
      <div class="mnav-links">
        <a href={u('/tsiny/')}>Ціни</a>
        <a href={u('/#kliienty')}>Клієнти</a>
        <a href={u('/#yak-pratsiuiemo')}>Як працюємо</a>
        <a href={u('/kontakty/')}>Контакти</a>
      </div>
      <a href={`tel:${company.phoneHref}`} class="btn btn-ghost btn-block"><Icon name="phone" size={18} /> {company.phone}</a>
      <button type="button" class="btn btn-primary btn-block" data-open-callback>Передзвоніть мені</button>
    </div>
  </div>
</header>

<style>
  .hdr { position: sticky; top: 0; z-index: 50; transition: background .3s ease, border-color .3s ease, backdrop-filter .3s ease; border-bottom: 1px solid transparent; }
  .hdr.scrolled, .hdr.open { background: rgba(10, 15, 12, 0.78); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); border-bottom-color: var(--line); }
  .hdr-in { height: var(--header-h); display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .logo { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
  .logo-mark { width: 30px; height: 30px; border-radius: 9px; background: var(--green); color: var(--ink); display: grid; place-items: center; box-shadow: 0 0 22px rgba(61,220,90,.35); }
  .logo-name { font-weight: 800; font-size: 21px; letter-spacing: -0.03em; }
  .logo-tag { color: var(--muted); font-size: 14px; font-weight: 500; }

  .nav { display: flex; align-items: center; gap: 6px; }
  .nav-link { display: inline-flex; align-items: center; gap: 6px; padding: 10px 12px; border-radius: 10px; font-size: 15px; color: var(--muted); transition: color .2s ease; }
  .nav-link:hover, .nav-link.active { color: var(--text); }
  .nav-drop { position: relative; }
  .drop { position: absolute; top: calc(100% + 6px); left: -12px; width: 330px; padding: 8px; border-radius: 18px; background: rgba(18, 26, 21, 0.96); border: 1px solid var(--line-2); box-shadow: 0 24px 60px rgba(0,0,0,.5); -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px);
    opacity: 0; visibility: hidden; transform: translateY(6px); transition: all .2s ease; }
  .nav-drop:hover .drop, .nav-drop:focus-within .drop { opacity: 1; visibility: visible; transform: none; }
  .drop-item { display: flex; gap: 12px; align-items: center; padding: 10px; border-radius: 12px; }
  .drop-item:hover { background: rgba(255,255,255,.05); }
  .drop-item b { display: block; font-size: 14px; font-weight: 700; }
  .drop-item small { color: var(--muted); font-size: 12.5px; }
  .drop-ico { width: 36px; height: 36px; flex-shrink: 0; border-radius: 10px; background: var(--green-soft); color: var(--green); display: grid; place-items: center; }

  .hdr-cta { display: flex; align-items: center; gap: 16px; }
  .hdr-phone { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 15px; white-space: nowrap; }
  .hdr-phone :global(svg) { color: var(--green); }
  .hdr-btn { min-height: 42px; padding: 9px 18px; font-size: 14px; }
  .hdr-call-m, .burger { display: none; width: 44px; height: 44px; border-radius: 12px; border: 1px solid var(--line-2); background: rgba(255,255,255,.03); place-items: center; cursor: pointer; }
  .hdr-call-m { color: var(--green); }

  .mnav { border-top: 1px solid var(--line); padding: 16px 0 24px; height: calc(100dvh - var(--header-h)); overflow-y: auto; }
  .mnav .wrap { display: grid; gap: 10px; }
  .mnav-label { font-size: 12px; text-transform: uppercase; letter-spacing: .12em; color: var(--muted); margin-top: 4px; }
  .mnav-svc { display: flex; align-items: center; gap: 12px; padding: 8px 0; font-weight: 600; }
  .mnav-links { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin: 8px 0; }
  .mnav-links a { padding: 12px 14px; border-radius: 12px; background: var(--panel); border: 1px solid var(--line); font-weight: 600; }

  @media (max-width: 1080px) { .hdr-phone { display: none; } }
  @media (max-width: 920px) {
    .nav, .hdr-btn { display: none; }
    .hdr-call-m, .burger { display: grid; }
    .hdr-cta { gap: 8px; }
  }
  @media (max-width: 380px) { .logo-tag { display: none; } }
</style>

<script>
  const hdr = document.getElementById('hdr')!;
  const burger = document.getElementById('burger')!;
  const mnav = document.getElementById('mnav')!;
  const onScroll = () => hdr.classList.toggle('scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  const setOpen = (open: boolean) => {
    mnav.hidden = !open;
    hdr.classList.toggle('open', open);
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Закрити меню' : 'Відкрити меню');
    document.body.style.overflow = open ? 'hidden' : '';
  };
  burger.addEventListener('click', () => setOpen(mnav.hidden));
  mnav.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a, [data-open-callback]')) setOpen(false); });
  window.addEventListener('resize', () => { if (window.innerWidth > 920 && !mnav.hidden) setOpen(false); });
</script>
