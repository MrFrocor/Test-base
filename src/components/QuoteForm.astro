---
import services from '../content/services.json';
interface Props { id: string; full?: boolean; selected?: string; submitLabel?: string }
const { id, full = false, selected = '', submitLabel = 'Отримати ціну за 15 хв' } = Astro.props;
---
<form class="qf" data-demo-form novalidate>
  {full && (
    <div class="field">
      <label for={`${id}-name`}>Ваше ім'я</label>
      <input class="input" id={`${id}-name`} name="name" autocomplete="name" placeholder="Як до вас звертатися" />
    </div>
  )}
  <div class="field">
    <label for={`${id}-svc`}>Послуга</label>
    <select class="input" id={`${id}-svc`} name="service">
      {services.map((s) => <option value={s.slug} selected={s.slug === selected}>{s.title}</option>)}
      <option value="inshe">Інше / потрібна консультація</option>
    </select>
  </div>
  <div class="input-row">
    <div class="field">
      <label for={`${id}-area`}>Площа, м²</label>
      <input class="input" id={`${id}-area`} name="area" inputmode="numeric" placeholder="Напр. 120" />
    </div>
    <div class="field">
      <label for={`${id}-phone`}>Телефон *</label>
      <input class="input" id={`${id}-phone`} name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+380" required />
    </div>
  </div>
  {full && (
    <div class="field">
      <label for={`${id}-msg`}>Коментар</label>
      <textarea class="input" id={`${id}-msg`} name="message" placeholder="Тип об'єкта, побажання щодо часу, адреса"></textarea>
    </div>
  )}
  <p class="qf-err" role="alert" hidden>Вкажіть, будь ласка, номер телефону</p>
  <button type="submit" class="btn btn-primary btn-block">{submitLabel}</button>
  <p class="qf-note">Безкоштовний виїзд на оцінку · Зв'яжемося у Viber, Telegram або дзвінком</p>
  <div class="qf-ok" hidden>
    <div class="qf-ok-ico">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
    </div>
    <b>Дякуємо, заявку прийнято!</b>
    <p>Менеджер зв'яжеться з вами найближчим часом.</p>
    <small>Демо-версія: у робочій версії заявка надійде менеджеру.</small>
  </div>
</form>

<style>
  .qf { display: grid; gap: 14px; position: relative; }
  .qf-note { font-size: 12.5px; color: var(--muted); text-align: center; }
  .qf-err { font-size: 13px; color: #ff8a7a; margin-top: -4px; }
  .qf-ok { position: absolute; inset: -6px; border-radius: 18px; background: rgba(13, 20, 15, 0.96); display: grid; place-content: center; text-align: center; gap: 8px; padding: 20px; }
  .qf-ok-ico { width: 56px; height: 56px; margin: 0 auto 6px; border-radius: 50%; background: var(--green); color: var(--ink); display: grid; place-items: center; box-shadow: 0 0 40px rgba(61,220,90,.45); }
  .qf-ok b { font-size: 18px; }
  .qf-ok p { color: var(--muted); font-size: 14px; }
  .qf-ok small { color: #6f7d73; font-size: 12px; }
</style>
