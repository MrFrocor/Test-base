---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base title="Сторінку не знайдено | ПП «333»">
  <section class="nf">
    <span class="spark" style="left:30%;top:20%"></span>
    <span class="spark" style="right:28%;bottom:24%;transform:scale(.7)"></span>
    <div class="wrap">
      <p class="code">404</p>
      <h1>Тут уже чисто, навіть сторінки немає</h1>
      <p class="muted">Можливо, посилання застаріло. Поверніться на головну або оберіть послугу.</p>
      <div class="acts">
        <a href={u('/')} class="btn btn-primary">На головну</a>
        <a href={u('/#poslugy')} class="btn btn-ghost">Послуги</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { position: relative; text-align: center; padding: clamp(60px, 12vw, 140px) 0; }
  .code { font-size: clamp(80px, 16vw, 160px); font-weight: 800; color: var(--green-ink); line-height: 1; letter-spacing: -0.05em; text-shadow: 0 10px 40px rgba(52,199,89,.3); }
  h1 { font-size: clamp(26px, 3.6vw, 38px); margin: 16px 0 12px; }
  .acts { display: flex; justify-content: center; gap: 12px; margin-top: 28px; flex-wrap: wrap; }
</style>
