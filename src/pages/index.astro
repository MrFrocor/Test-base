---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import QuoteForm from '../components/QuoteForm.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CtaBand from '../components/CtaBand.astro';
import site from '../content/site.json';
import services from '../content/services.json';
const { hero, stats, logos, advantages, steps, faq, company } = site;

const clients = [
  { name: 'Арена Львів', text: 'Генеральне післябудівельне прибирання стадіону перед Євро-2012' },
  { name: 'Аеропорт «Львів»', text: 'Обслуговування міжнародного аеропорту імені Данила Галицького' },
  { name: 'Victoria Gardens', text: 'Клінінг найбільшого торгового центру Західної України' }
];
---
<Base>
  <!-- HERO -->
  <section class="hero">
    <svg class="deco-line" viewBox="0 0 1440 900" preserveAspectRatio="none" aria-hidden="true">
      <path d="M-40 420 C 260 220, 520 760, 820 560 S 1240 180, 1480 380" fill="none" stroke="#3ddc5a" stroke-opacity=".4" stroke-width="1.5" />
    </svg>
    <span class="spark spark-top" style="left:46%;top:12%"></span>
    <span class="spark" style="left:4%;top:78%;transform:scale(.7)"></span>
    <span class="spark" style="right:5%;top:86%;transform:scale(.8);animation-delay:1.2s"></span>

    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">{hero.badge}</span>
        <h1>
          {hero.titleStart}{' '}
          <span class="circled">{hero.titleAccent}<svg viewBox="0 0 200 60" preserveAspectRatio="none" aria-hidden="true"><ellipse cx="100" cy="31" rx="97" ry="26" fill="none" stroke="#3ddc5a" stroke-width="2" transform="rotate(-2 100 30)" /></svg></span>
        </h1>
        <p class="hero-text">{hero.text}</p>
        <div class="hero-actions">
          <a href="#rozrakhunok" class="btn btn-primary hero-cta-m">{hero.primaryCta} <Icon name="arrow" size={18} class="icon-arrow" /></a>
          <button type="button" class="btn btn-primary hero-cta-d" data-focus-quote>{hero.primaryCta} <Icon name="arrow" size={18} class="icon-arrow" /></button>
          <a href={`tel:${company.phoneHref}`} class="btn btn-ghost"><Icon name="phone" size={18} /> {company.phone}</a>
        </div>
        <div class="hero-trust">
          <div class="avatars" aria-hidden="true"><span></span><span></span><span></span></div>
          <p><b>{hero.trustTitle}</b><br /><span class="muted">{hero.trustText}</span></p>
        </div>
      </div>

      <div class="hero-visual" id="rozrakhunok">
        <div class="orb" aria-hidden="true"></div>
        <div class="quote glass">
          <div class="quote-head">
            <h2>Швидкий розрахунок</h2>
            <span class="online">онлайн</span>
          </div>
          <QuoteForm id="hero" />
        </div>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="stats-sec">
    <div class="wrap">
      <div class="stats reveal">
        {stats.map((s) => (
          <div class="stat"><b>{s.value}</b><span>{s.label}</span></div>
        ))}
      </div>
    </div>
  </section>

  <!-- LOGOS -->
  <div class="logos" aria-label="Клієнти та партнери">
    <div class="logos-track">
      {[...logos, ...logos].map((l, i) => <span aria-hidden={i >= logos.length ? 'true' : undefined}>{l}</span>)}
    </div>
  </div>

  <!-- SERVICES -->
  <section class="section" id="poslugy">
    <span class="spark" style="right:8%;top:70px;transform:scale(.8)"></span>
    <div class="wrap">
      <div class="section-head center">
        <h2 class="h2">Що ми пропонуємо?</h2>
        <p>Ціни одразу на сайті, без завантаження PDF. Точну вартість рахуємо після безкоштовного огляду.</p>
      </div>
      <div class="svc-grid">
        {services.map((s) => <ServiceCard s={s} />)}
      </div>
    </div>
  </section>

  <!-- CLIENTS -->
  <section class="section clients-sec" id="kliienty">
    <svg class="deco-line" viewBox="0 0 1440 600" preserveAspectRatio="none" aria-hidden="true">
      <path d="M1480 80 C 1100 260, 640 40, 380 260 S 120 520, -40 480" fill="none" stroke="#3ddc5a" stroke-opacity=".25" stroke-width="1.5" />
    </svg>
    <div class="wrap">
      <div class="section-head">
        <h2 class="h2">Нам довіряють великі об'єкти</h2>
        <p>Довгострокові контракти від 3 років. Якщо ми впоралися зі стадіоном і аеропортом, впораємося і з вашим офісом.</p>
      </div>
      <div class="clients">
        {clients.map((c, i) => (
          <div class="card client reveal" style={`transition-delay:${i * 80}ms`}>
            <span class="client-n">0{i + 1}</span>
            <h3>{c.name}</h3>
            <p class="muted">{c.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ADVANTAGES -->
  <section class="section">
    <div class="wrap">
      <div class="section-head center">
        <h2 class="h2">Чому обирають «333»</h2>
      </div>
      <div class="adv-grid">
        {advantages.map((a, i) => (
          <div class="adv reveal" style={`transition-delay:${(i % 3) * 70}ms`}>
            <div class="icon-box"><Icon name={a.icon} /></div>
            <div>
              <h3>{a.title}</h3>
              <p class="muted">{a.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- STEPS -->
  <section class="section" id="yak-pratsiuiemo">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h2">Працювати з нами просто</h2>
        <p>Чотири кроки від заявки до чистого об'єкта.</p>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="card step reveal" style={`transition-delay:${i * 80}ms`}>
            <span class="step-n">0{i + 1}</span>
            <h3>{s.title}</h3>
            <p class="muted">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq">
    <div class="wrap faq-grid">
      <div class="section-head">
        <h2 class="h2">Питання і відповіді</h2>
        <p>Не знайшли відповідь? Зателефонуйте, і ми проконсультуємо безкоштовно.</p>
        <a href={`tel:${company.phoneHref}`} class="btn btn-outline" style="margin-top:22px"><Icon name="phone" size={18} /> {company.phone}</a>
      </div>
      <div class="faq">
        {faq.map((f, i) => (
          <details class="faq-item" open={i === 0}>
            <summary>{f.q}<span class="faq-ico"><Icon name="plus" size={18} /></span></summary>
            <p class="muted">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<script>
  // Desktop CTA focuses the quick-quote form right next to it
  document.querySelector('[data-focus-quote]')?.addEventListener('click', () => {
    const el = document.getElementById('hero-svc') as HTMLSelectElement | null;
    el?.focus();
    el?.closest('.quote')?.classList.add('pulse');
    setTimeout(() => el?.closest('.quote')?.classList.remove('pulse'), 1200);
  });
</script>

<style>
  /* HERO */
  .hero { position: relative; padding: clamp(32px, 6vw, 72px) 0 clamp(40px, 6vw, 64px); overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(28px, 4vw, 56px); align-items: center; }
  .hero h1 { font-size: clamp(38px, 5.4vw, 64px); letter-spacing: -0.035em; margin: 22px 0 0; }
  .circled { position: relative; display: inline-block; color: var(--green); white-space: nowrap; }
  .circled svg { position: absolute; left: -12px; top: -10px; width: calc(100% + 24px); height: calc(100% + 20px); }
  .hero-text { color: var(--muted); font-size: clamp(16px, 1.4vw, 18px); max-width: 520px; margin: 22px 0 30px; }
  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .hero-cta-m { display: none; }
  .hero-trust { display: flex; align-items: center; gap: 14px; margin-top: 30px; font-size: 14px; line-height: 1.4; }
  .avatars { display: flex; }
  .avatars span { width: 36px; height: 36px; border-radius: 50%; border: 2px solid var(--bg); background: linear-gradient(135deg, #3b4b40, #22302700); background-color: #2c3a30; }
  .avatars span + span { margin-left: -10px; background-color: #3b4b40; }
  .avatars span:last-child { background-color: var(--green-d); }

  .hero-visual { position: relative; min-height: 480px; display: grid; align-items: center; }
  .orb { position: absolute; right: -14%; top: 50%; width: min(440px, 80%); aspect-ratio: 1; transform: translateY(-50%); border-radius: 50%;
    background: radial-gradient(circle at 34% 32%, #5df07a, #1a9e37 62%, #0f6a25); box-shadow: 0 0 120px rgba(61, 220, 90, 0.35); }
  .quote { position: relative; width: min(420px, 100%); padding: 26px; transform: rotate(-3deg);
    background: linear-gradient(145deg, rgba(30, 46, 36, 0.78), rgba(10, 16, 12, 0.72)); box-shadow: 0 40px 80px rgba(0, 0, 0, 0.45); transition: transform .4s ease, box-shadow .4s ease; }
  .quote:hover, .quote:focus-within { transform: rotate(0); }
  .quote.pulse { box-shadow: 0 0 0 3px var(--green), 0 40px 80px rgba(0,0,0,.45); }
  .quote-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; }
  .quote-head h2 { font-size: 20px; }
  .online { font-size: 12.5px; color: var(--green); display: inline-flex; align-items: center; gap: 6px; }
  .online::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--green); box-shadow: 0 0 8px var(--green); }

  /* STATS */
  .stats-sec { position: relative; z-index: 2; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); background: rgba(18, 26, 21, 0.85); border: 1px solid var(--line); border-radius: 24px; padding: clamp(22px, 3vw, 34px) 12px; -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
  .stat { text-align: center; padding: 6px 10px; }
  .stat + .stat { border-left: 1px solid var(--line); }
  .stat b { display: block; font-size: clamp(26px, 3.2vw, 40px); font-weight: 800; letter-spacing: -0.03em; }
  .stat span { color: var(--muted); font-size: 14px; }

  /* LOGOS */
  .logos { overflow: hidden; padding: clamp(32px, 5vw, 48px) 0 8px; mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .logos-track { display: flex; gap: clamp(40px, 6vw, 80px); width: max-content; animation: marquee 36s linear infinite; }
  .logos-track span { font-weight: 800; font-size: clamp(16px, 1.6vw, 20px); letter-spacing: 0.06em; text-transform: uppercase; color: #56635a; white-space: nowrap; }
  @keyframes marquee { to { transform: translateX(-50%); } }

  /* SERVICES */
  .svc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .svc-grid > :global(.wide) { grid-column: span 2; }

  /* CLIENTS */
  .clients { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .client h3 { font-size: 22px; margin: 18px 0 8px; }
  .client-n { color: var(--green); font-weight: 800; font-size: 14px; }

  /* ADVANTAGES */
  .adv-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 3vw, 36px) clamp(20px, 3vw, 32px); }
  .adv { display: flex; gap: 16px; align-items: flex-start; }
  .adv .icon-box { margin: 0; flex-shrink: 0; }
  .adv h3 { font-size: 17px; margin-bottom: 6px; }
  .adv p { font-size: 15px; }

  /* STEPS */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; counter-reset: s; }
  .step-n { color: var(--green); font-weight: 800; }
  .step h3 { font-size: 18px; margin: 14px 0 8px; }
  .step p { font-size: 15px; }
  .step::after { content: ''; position: absolute; top: 34px; right: -12px; width: 8px; height: 8px; border-top: 2px solid var(--green); border-right: 2px solid var(--green); transform: rotate(45deg); opacity: .6; }
  .step:last-child::after { display: none; }

  /* FAQ */
  .faq-grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(24px, 5vw, 64px); align-items: start; }
  .faq { display: grid; gap: 10px; }
  .faq-item { background: var(--panel); border: 1px solid var(--line); border-radius: 18px; padding: 0 22px; transition: border-color .2s ease; }
  .faq-item[open] { border-color: rgba(61, 220, 90, .3); }
  .faq-item summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 20px 0; font-weight: 700; font-size: 16.5px; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-ico { width: 32px; height: 32px; flex-shrink: 0; border-radius: 50%; background: var(--green-soft); color: var(--green); display: grid; place-items: center; transition: transform .25s ease; }
  .faq-item[open] .faq-ico { transform: rotate(45deg); }
  .faq-item p { padding: 0 0 20px; font-size: 15.5px; }

  @media (max-width: 1000px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-visual { min-height: auto; padding: 24px 0 8px; justify-items: center; }
    .orb { right: -30%; width: 420px; }
    .quote { transform: none; }
    .hero-cta-m { display: inline-flex; }
    .hero-cta-d { display: none; }
    .svc-grid { grid-template-columns: 1fr 1fr; }
    .svc-grid > :global(.wide) { grid-column: span 2; }
    .adv-grid { grid-template-columns: 1fr 1fr; }
    .steps { grid-template-columns: 1fr 1fr; }
    .step::after { display: none; }
    .faq-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .stats { grid-template-columns: 1fr 1fr; gap: 18px 0; }
    .stat:nth-child(3) { border-left: 0; }
    .svc-grid, .clients, .adv-grid, .steps { grid-template-columns: 1fr; }
    .svc-grid > :global(.wide) { grid-column: auto; }
    .hero-actions .btn { flex: 1 1 100%; }
    .spark-top { left: auto !important; right: 8%; top: 3% !important; }
    .faq-item { padding: 0 18px; }
  }
</style>
